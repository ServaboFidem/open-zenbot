# zen-agents environment settings
#
# Copy to .env and uncomment what you want to change. Every line shows the default.
# The harness and the desktop app each read the repo's .env when they start, however they are
# launched, and print the names they loaded (never the values). A variable already set in the shell
# wins over the file. Restart both after editing .env.
# .env holds secrets: never commit it.

# ---------------------------------------------------------------------------
# Provider and keys
# ---------------------------------------------------------------------------
# OpenRouter API key. Set, the harness binds the provider at start; unset, add a key in Settings > Model providers.
# Once Settings has saved providers (vault-settings/providers.json) and models (vault-settings/harness.json),
# those win over the provider and model settings below.
# OPENROUTER_API_KEY=sk-or-...
# Where the key comes from: env:NAME (an environment variable) or vault:NAME (with VAULT_NAME set).
# ZEN_KEY_REF=env:OPENROUTER_API_KEY
# Model provider kind.
# ZEN_PROVIDER=openrouter
# Chat model for bot tasks. Empty uses the provider's default.
# OPENROUTER_MODEL=
# Model for every summary: in-task compaction, conversation folds, vault docs.
# ZEN_SUMMARY_MODEL=scaledown/summarize

# Image generation (the image.generate tool, offered to a bot when the decider scores it a fit).
# Settings > Harness Tools changes these too; a choice saved there (vault-settings/tools.json) wins over this file.
# 0 turns the tool off.
# ZEN_IMAGE_ENABLED=1
# Provider: openrouter is the only one today; any other value turns the tool off. Uses the key above.
# ZEN_IMAGE_PROVIDER=openrouter
# Image model on that provider (openrouter.ai/models?output_modalities=image).
# ZEN_IMAGE_MODEL=tencent/hy-image-v3.5-preview

# ---------------------------------------------------------------------------
# Harness server and paths
# ---------------------------------------------------------------------------
# Address and port the harness listens on. dev.sh/dev.ps1 set ZEN_PORT from --port / -Port.
# ZEN_HOST=127.0.0.1
# ZEN_PORT=8765
# Harness URL the Electron app talks to. dev.sh/dev.ps1 set it to follow ZEN_PORT.
# ZEN_HARNESS_URL=http://127.0.0.1:8765
# Comma-separated origins allowed to call the harness (CORS).
# ZEN_GUI_ORIGINS=app://openzenbot
# Extra hosts whose images and video show in chat without a click (comma-separated; Pexels is always trusted).
# ZEN_MEDIA_TRUSTED_HOSTS=
# The vault: memory, rooms, conversations, ledger.
# ZEN_VAULT=~/.zen-agents/vault
# Skills directory, bot identity prompts directory, MCP server config.
# ZEN_SKILLS=skills
# ZEN_BOT_PROMPTS=bot-prompts
# Shipped design systems (one folder each: DESIGN.md, optional tokens.css); the user's own live in <vault>/design-systems.
# ZEN_DESIGN_SYSTEMS=design-systems
# ZEN_MCP_CONFIG=mcp.json

# ---------------------------------------------------------------------------
# MCP servers (read by mcp.json)
# ---------------------------------------------------------------------------
# Exa search key. Unset, the exa server runs keyless at a free rate limit.
# EXA_API_KEY=
# Pexels key (free, pexels.com/api). Unset, the pexels server connects but every tool answers that the key is empty.
# PEXELS_API_KEY=
# ToolsMonk key (toolsmonk.com/account/mcp), sent as Authorization: Bearer. Unset, the catalog tools work but run_tool
# answers that an account is required.
# TOOLSMONK_API_KEY=
# Any of these keys can instead be saved on the MCP servers page (vault-settings/mcp_keys.json); a key saved there
# wins over this file for that server.
# A second folder the filesystem MCP may read and write (the vault is always one). More folders can be added,
# without a restart, on Settings > Allowed Folders (vault-settings/allowed_folders.json).
# ZEN_FS_ROOT=~/Documents

# ---------------------------------------------------------------------------
# Task loop and tools
# ---------------------------------------------------------------------------
# Most model calls one task may make before it fails.
# ZEN_MAX_STEPS=50
# Shell tool: seconds before a command is killed, and the bots' working folder: where shell commands
# start and generated images land (default <vault>/workspace, created at start).
# ZEN_SHELL_TIMEOUT=60
# ZEN_SHELL_CWD=~/.zen-agents/vault/workspace
# A shell command runs without asking only when the decider puts "writes only inside the folders bots may
# use" at or above this probability; anything less, a decider error, or no decider waits for approval.
# ZEN_SHELL_WRITE_PASS=0.8
# Delegating to Claude Code (Settings > Harness Tools > Coding agents): seconds before a run is stopped.
# ZEN_DELEGATE_TIMEOUT=900
# Largest skill file loaded (bytes), and most skills one bot may hold.
# ZEN_MAX_SKILL_BYTES=256000
# ZEN_MAX_SKILLS_PER_BOT=250

# ---------------------------------------------------------------------------
# Context size and conversations
# ---------------------------------------------------------------------------
# A task's messages past this many characters are compacted into a summary...
# ZEN_CONTEXT_BUDGET_CHARS=120000
# ...keeping this many recent turns as they are.
# ZEN_KEEP_RECENT_TURNS=6
# A conversation's history past this many characters folds its oldest exchanges into a summary
# (down to half this size)...
# ZEN_CONVERSATION_BUDGET_CHARS=60000
# ...keeping the last this-many exchanges unfolded while they fit.
# ZEN_CONVERSATION_KEEP=6
# Turn notes: when a task or room turn ends, the summary model writes the bot a short note (what it found,
# made and left) that its next turn in the same conversation reads, and the router scores with. 0 turns it off.
# ZEN_TURN_NOTES=1
# Longest note, in characters.
# ZEN_TURN_NOTE_CHARS=1500
# Seconds the note's summary call may take before a plain note built from the tool results stands in.
# ZEN_TURN_NOTE_TIMEOUT=20

# ---------------------------------------------------------------------------
# Decider: skill/MCP routing and the loop supervisor
# ---------------------------------------------------------------------------
# Scorer that picks skills and MCPs per message and runs the supervisor.
# ZEN_SCORER=openrouter-decision-1
# Model the scorer uses. Empty uses the scorer's default.
# OPENROUTER_DECISION_MODEL=
# Skills within this much of the top score count as a tie and are all kept...
# ZEN_BAND_WIDTH=0.1
# ...up to this many skills and this many MCP servers.
# ZEN_BAND_K_SKILL=3
# ZEN_BAND_K_MCP=3
# MCP servers work together rather than compete, so every server scoring at least this loads
# (up to ZEN_BAND_K_MCP), however high the top one scored. A bot's own servers (`mcps:` in its
# bot-prompts file) always load and are not scored.
# ZEN_MCP_FLOOR=0.5
# Below this top score the router picks nothing for that kind (defers).
# ZEN_LOW_CONFIDENCE=0.2
# Fit: top two bots within this score are a tie, settled by a tiebreaker.
# ZEN_FIT_TIE_WIDTH=0.1
# 1: when the scorer call fails, offer the bot all its skills and every MCP. 0: the task fails instead.
# ZEN_ROUTER_FAIL_OPEN=1
# Supervisor: check a running task every this-many steps.
# ZEN_SUPERVISE_EVERY=5
# Supervisor: stop a task when it is this sure the task is looping or repeating itself (0-1).
# ZEN_HALT_LOOPING=0.8
# ZEN_HALT_REPEATING=0.8
# Supervisor: nudge the bot to change approach at these confidences (0-1).
# ZEN_NUDGE_LOOPING=0.5
# ZEN_NUDGE_STUCK=0.4

# ---------------------------------------------------------------------------
# Rooms and ZenBot routing
# ---------------------------------------------------------------------------
# Fewest and most bots in a room.
# ZEN_ROOM_MIN=2
# ZEN_ROOM_MAX=6
# Seconds a bot's room turn may run.
# ZEN_TURN_DEADLINE_S=600
# Posts of the thread a bot sees on its turn.
# ZEN_ROOM_THREAD_POSTS=20
# Longest bot-to-bot mention chain.
# ZEN_ROOM_MAX_HOPS=4
# Most bots that may be invited into a room per request.
# ZEN_ROOM_MAX_INVITES=2
# ZenBot: a message scoring at least this against an existing room's topic continues that room.
# ZEN_ROUTE_CONTINUE=0.6
# ZenBot: least score for a specialist bot to be picked for a new room.
# ZEN_ROUTE_SPECIALIST_MIN=0.5
# ZenBot: minutes its last exchange stays fresh as context for routing and new rooms.
# ZEN_ROUTE_CONTEXT_MINUTES=30

# ---------------------------------------------------------------------------
# Memory recall
# ---------------------------------------------------------------------------
# Memory backend: hindsight (a Hindsight server) or local (a graph file in the vault).
# ZEN_MEMORY_BACKEND=hindsight
# Facts scoring at or above this floor are offered to the bot (0-1), up to ZEN_RECALL_K.
# ZEN_RECALL_FLOOR=0.5
# ZEN_RECALL_K=5
# Candidates taken from each memory source before scoring.
# ZEN_RECALL_PER_SOURCE=8
# 1: also recall knowledge-graph lines from Hindsight. 0: facts only.
# ZEN_RECALL_GRAPH=1
# Graph lines offered, and graph candidates scored.
# ZEN_RECALL_GRAPH_K=5
# ZEN_RECALL_GRAPH_CANDIDATES=12
# Seconds a graph recall or store search may take. dev.sh raises this to 60.
# ZEN_RECALL_GRAPH_TIMEOUT=20
# Decider confidence (0-1) needed to promote a fact to a wider tier (e.g. private -> project).
# ZEN_PROMOTE_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# Importing files into memory
# ---------------------------------------------------------------------------
# Folders files may be ingested from, separated by : (Linux/macOS) or ; (Windows).
# Empty means only <vault>/uploads.
# MD_ALLOWED_PATHS=
# Largest file an import takes, in bytes (20 MB).
# ZEN_IMPORT_MAX_BYTES=20000000

# ---------------------------------------------------------------------------
# Hindsight memory server (started by the harness)
# ---------------------------------------------------------------------------
# An external Hindsight server. Set, the harness starts none and ignores the ports below.
# ZEN_HINDSIGHT_URL=
# API port and embedded Postgres port of the server the harness starts.
# ZEN_HINDSIGHT_PORT=18888
# ZEN_HINDSIGHT_PG_PORT=5556
# Model Hindsight extracts and consolidates memories with (via OpenRouter).
# ZEN_HINDSIGHT_LLM_MODEL=google/gemma-4-31b-it
# Key Hindsight uses. Set, it is pinned and binding a key in Settings does not move it.
# ZEN_HINDSIGHT_KEY_REF=env:OPENROUTER_API_KEY
# 0 skips the dashboard (control plane) behind the Knowledge page.
# ZEN_HINDSIGHT_UI=1
# Dashboard port. On any port other than 9999 it opens in the browser instead of inside the app.
# ZEN_HINDSIGHT_UI_PORT=9999
# Seconds to wait for the server to come up.
# ZEN_HINDSIGHT_READY_TIMEOUT=300
# Passed through to Hindsight: record LLM call traces (shown in the dashboard).
# HINDSIGHT_API_LLM_TRACE_ENABLED=true
# Passed through to Hindsight: consolidate memories into observations.
# HINDSIGHT_API_ENABLE_OBSERVATIONS=true
# Passed through to Hindsight: keep an audit log of operations.
# HINDSIGHT_API_AUDIT_LOG_ENABLED=true
# Passed through to Hindsight: seconds each reflect LLM call may take (Hindsight's own default, 30, is too short
# for a broad reflect on a large bank).
# HINDSIGHT_API_REFLECT_LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Skill recorder
# ---------------------------------------------------------------------------
# Longest recording, in seconds.
# ZEN_RECORD_MAX_S=600
# 1: show the recording browser window. 0: run it headless.
# ZEN_RECORD_HEADED=1

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# GlitchTip (Sentry) DSN. Set, the harness reports errors and traces there; unset, nothing is sent.
# ZEN_GLITCHTIP_DSN=https://<key>@<glitchtip-host>/<project-id>
